# Konfigurasi Supabase Bersama (Shared Backend untuk Repo 1 & Repo 2)
# Salin file ini menjadi .env.local dan isi dengan URL serta Key dari project Supabase Anda.
# Jika belum diisi saat pengembangan lokal, sistem otomatis menggunakan penyimpanan privat lokal di folder data/

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
